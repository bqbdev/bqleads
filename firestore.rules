
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null &&
        request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid}/leads/{leadId} {
      allow read, delete: if isAdmin() &&
        request.auth.uid == uid;

      allow create, update: if isAdmin() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly([
          'name','phone','address','website','status','createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 250 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 40 &&
        request.resource.data.address is string &&
        request.resource.data.address.size() <= 500 &&
        request.resource.data.website is string &&
        request.resource.data.website.size() <= 500 &&
        request.resource.data.status in [
          'novo','abordado','interessado',
          'negociando','vendido','descartado'
        ];
    }

    match /searchRuns/{runId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
